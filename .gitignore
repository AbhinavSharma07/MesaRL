# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Environment & secrets - VERY IMPORTANT
.env

# Virtual environments
.venv/
venv/
ENV/

# IDE / Editor specific
.idea/
.vscode/

# Pytest
.pytest_cache/
.coverage

# Trained models / run artifacts (regenerable via the CLI, kept out of git).
# runs/main is the reference result set discussed in README/PROJECT_DETAILS.md -- kept.
runs/*
!runs/main/
*.pt
*.pth
!runs/main/checkpoint.pt
